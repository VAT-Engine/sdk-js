  "retry": {
    "classes": {
      "calculation_conditional": {
        "automatic_retry": "only_if_reviewed_and_all_identity_conditions_hold",
        "replay": "Same tenant and endpoint, explicit transaction_date, original canonical inputs, Idempotency-Key and unchanged X-Source-ID attribution.",
        "window": "Mapping is retained for the lifetime of the original calculation. Verify safe policy limits before enabling."
      },
      "claim_polling": {
        "automatic_retry": false,
        "polling": "Distinguish authorization_pending from other conflicts. Caller-controlled polling respects interval, Retry-After and expiry.",
        "replay": "A valid token returns the same active approved key while it remains eligible."
      },
      "mutation_no_retry": {
        "automatic_retry": false,
        "constraint": "Review any exception against a documented replay contract."
      },
      "read_candidate": {
        "automatic_retry": "pending_operation_review",
        "constraint": "Check operation effects and retryable conditions before enabling."
      },
      "registration_no_retry": {
        "automatic_retry": false,
        "constraint": "A lost response can leave a pending request. Require explicit caller intent."
      },
      "supply_conditional": {
        "automatic_retry": "only_if_reviewed_and_all_identity_conditions_hold",
        "replay": "Same authorized context, supply identity, revision, facts and original-sale binding where applicable.",
        "window": "Verify retained revision and replay conditions. Never assign a new event revision to get around a conflict."
      }
    },
    "default": "no_automatic_retry"
  }
}
